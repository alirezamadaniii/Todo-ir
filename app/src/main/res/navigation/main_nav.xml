<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_nav"
    app:startDestination="@id/homeFragment">


    <fragment
        android:id="@+id/homeFragment"
        android:name="com.example.todoir.peresentaion.ui.home.HomeFragment"
        android:label="HomeFragment" />
    <navigation android:id="@+id/intro_navigation"
        app:startDestination="@id/firstIntroFragment">
        <fragment
            android:id="@+id/firstIntroFragment"
            android:name="com.example.todoir.peresentaion.ui.intro.FirstIntroFragment"
            android:label="fragment_first_intro"
            tools:layout="@layout/fragment_first_intro">
            <action
                android:id="@+id/action_firstIntroFragment_to_secondIntroFragment"
                app:destination="@id/secondIntroFragment"
                app:enterAnim="@anim/anim_right_to_left"
                app:popEnterAnim="@anim/anim_left_to_right" />
        </fragment>
        <fragment
            android:id="@+id/secondIntroFragment"
            android:name="com.example.todoir.peresentaion.ui.intro.SecondIntroFragment"
            android:label="fragment_second_intro"
            tools:layout="@layout/fragment_second_intro">

            <action
                android:id="@+id/action_secondIntroFragment_to_registerFragment"
                app:destination="@id/registerFragment"
                app:enterAnim="@anim/anim_right_to_left"
                app:popEnterAnim="@anim/anim_left_to_right" />
        </fragment>
        <fragment
            android:id="@+id/registerFragment"
            android:name="com.example.todoir.peresentaion.ui.intro.RegisterFragment"
            android:label="fragment_register"
            tools:layout="@layout/fragment_register">
            <action
                android:id="@+id/action_registerFragment_to_welcomeIntroFragment"
                app:destination="@id/welcomeIntroFragment"
                app:enterAnim="@anim/anim_right_to_left"
                app:popEnterAnim="@anim/anim_left_to_right" />
        </fragment>
        <fragment
            android:id="@+id/welcomeIntroFragment"
            android:name="com.example.todoir.peresentaion.ui.intro.WelcomeIntroFragment"
            android:label="fragment_welcome_intro"
            tools:layout="@layout/fragment_welcome_intro">
            <action
                android:id="@+id/action_welcomeIntroFragment_to_homeFragment"
                app:destination="@id/homeFragment"
                app:popUpTo="@id/firstIntroFragment"
                app:popUpToInclusive="true" />
        </fragment>
    </navigation>
    <fragment
        android:id="@+id/addTaskFragment"
        android:name="com.example.todoir.peresentaion.ui.addtask.AddTaskFragment"
        android:label="fragment_add_task"
        tools:layout="@layout/fragment_add_task" >
        <action
            android:id="@+id/action_addTaskFragment_to_createCategoryFragment"
            app:destination="@id/createCategoryFragment" />
    </fragment>
    <fragment
        android:id="@+id/profileFragment"
        android:name="com.example.todoir.peresentaion.ui.profile.ProfileFragment"
        android:label="ProfileFragment" />
    <fragment
        android:id="@+id/createCategoryFragment"
        android:name="com.example.todoir.peresentaion.ui.CreateCategoryFragment"
        android:label="CreateCategoryFragment" />
</navigation>